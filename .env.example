# DeepSeek（复制本文件为 .env.local 后填写）
DEEPSEEK_API_KEY=sk-your-key-here

# 可选：覆盖 lib/ai/config.ts 中的默认值
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_THINKING=enabled
# DEEPSEEK_REASONING_EFFORT=high

# 智谱 GLM-4.6V-Flash（chat 图片 OCR / 公式转 LaTeX）
ZHIPU_API_KEY=your-zhipu-key-here
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_VISION_MODEL=glm-4.6v-flash
# GLM_THINKING=disabled

# 数据同步：最终存放 app.db 的目录（默认 %OneDrive%/db/dian_english）
# SYNC_DIR=C:\Users\you\OneDrive\db\dian_english
# history/ 保留份数（默认 10）
# SYNC_HISTORY_KEEP=10

